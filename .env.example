VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Backend Configuration
PORT=8080
SHUTDOWN_TIMEOUT=30s
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info
LOG_PRETTY=true

# Database Configuration (for local dev against the docker-compose postgres)
DATABASE_URL=postgres://restaurant:restaurant@localhost:5432/restaurant?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
MIGRATIONS_DIR=migrations

# Optional physical ESC/POS printer (raw TCP, often port 9100).
# Leave empty to use the local mock kitchen printer.
PRINTER_KITCHEN_ADDRESS=
PRINTER_CONNECT_TIMEOUT=3s

# Optional signed generic webhook provider. Both values must be set together.
WEBHOOK_PROVIDER_NAME=
WEBHOOK_PROVIDER_SECRET=

# Optional Swiggy webhook. Configure the signing secret supplied by Swiggy
# during restaurant/POS integration onboarding.
SWIGGY_WEBHOOK_SECRET=

# Auth Configuration
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
AUTH_REQUIRED=false
# Optional: https://your-project.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
